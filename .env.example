# Copy this file to .env and fill in real values. Never commit .env.
#
# Get these from your Supabase project's Settings -> API page (or from
# `supabase status` after `supabase start` for local development).

# --- Phase 1: Auth, RBAC, dashboards ---

# Client-visible (Vite exposes anything prefixed VITE_ to the browser bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix these with VITE_ — that would bundle them into
# client-side JS. Used only inside server functions / src/lib/supabase/admin.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (payment receipts, certificate-ready notices, announcements, and the
# contact-form/newsletter confirmation emails already wired up in Phase 1).
RESEND_API_KEY=

# Extra password gate in front of /admin/* — on top of Supabase auth + the
# admin role check, not a replacement for it. Not linked anywhere in the
# site UI; reach it by navigating to /admin directly.
ADMIN_ACCESS_PASSWORD=

# Manual bank-transfer details shown to students on /payment after they
# verify their email. Purely informational text — not a secret, but kept
# server-side/env-configured so it can change without a code deploy.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_TITLE=
PAYMENT_ACCOUNT_NUMBER=

# --- Later phases (not required yet, listed here so the shape is discoverable) ---

# Phase 3 — PayFast Pakistan
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=

# Phase 5 — AI Career Toolkit
# GROQ_API_KEY=
# GEMINI_API_KEY=
